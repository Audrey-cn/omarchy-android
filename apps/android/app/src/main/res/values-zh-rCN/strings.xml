    <!-- ==================== Settings Page ==================== -->
    <string name="tc4_settings_title">设置</string>
    <string name="tc4_settings_description">统一管理 Omarchy 桌面、X11 显示触控、输入法与系统权限。</string>
    <string name="tc4_settings_x11_touch_direct_title">直接触控模式</string>
    <string name="tc4_settings_x11_touch_direct_desc">开启后手指点哪即点击哪；关闭时为触控板模式（推荐，支持精准光标与双指滚动）</string>
    <string name="tc4_settings_x11_cutout_title">画面延伸至挖孔/圆角区</string>
    <string name="tc4_settings_x11_cutout_desc">让桌面画面铺满挖孔屏与大 R 角区域（需重启桌面生效）</string>
    <string name="tc4_settings_x11_fullscreen_title">沉浸全屏与屏幕常亮</string>
    <string name="tc4_settings_x11_fullscreen_desc">隐藏安卓系统状态栏，并在使用 Omarchy 桌面时保持屏幕常亮</string>
    <string name="tc4_settings_x11_ekbar_title">显示原生底部快捷栏</string>
    <string name="tc4_settings_x11_ekbar_desc">默认关闭以使用 Omarchy 悬浮键盘；如需 Termux 原生快捷按键栏可开启</string>
    <string name="tc4_settings_x11_title">高级 X11 显示与触控参数</string>
    <string name="tc4_settings_x11_desc">指针灵敏度、自定义分辨率、硬件键盘映射等完整 Termux:X11 参数</string>
