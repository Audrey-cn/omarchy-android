    <string name="tc4_settings_ime_title">系统输入法与豆包语音</string>
    <string name="tc4_settings_ime_desc">切换默认输入法（推荐搭配豆包输入法实现离线语音精准上屏）</string>
    <string name="tc4_settings_shortcut_title">启动器捷径生成器</string>
