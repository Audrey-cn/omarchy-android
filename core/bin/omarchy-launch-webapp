#!/usr/bin/env bash
# Video sites need normal browser navigation; tools default to an app window.
set -euo pipefail
mode=auto
case "${1:-}" in
    --app|--tab) mode="${1#--}"; shift ;;
esac
url="${1:-}"
[[ -n "$url" ]] || exit 0

# Match the URL's host, never a domain mentioned in its path, query or userinfo.
shopt -s nocasematch
if [[ "$mode" == auto && "$url" =~ ^https?:// ]]; then
    authority="${url#*://}"
    authority="${authority%%[/?#]*}"
    host="${authority##*@}"
    host="${host%%:*}"
    host="${host%.}"
    case "$host" in
        bilibili.com|*.bilibili.com|douyin.com|*.douyin.com|iqiyi.com|*.iqiyi.com|v.qq.com|*.v.qq.com|youku.com|*.youku.com|twitch.tv|*.twitch.tv|youtube.com|*.youtube.com)
            mode=tab
            ;;
    esac
fi
if [[ "$mode" == tab ]]; then
    # Video sites need full HTML5 MSE/H.264/AAC and smooth touchpad scrolling.
    # Prefer Mozilla Firefox, then pre-installed Playwright Chromium, then WebKitGTK.
    if command -v firefox >/dev/null 2>&1; then
        if command -v omarchy-firefox >/dev/null 2>&1; then
            exec omarchy-firefox "$url"
        fi
        exec firefox "$url"
    fi
    if command -v omarchy-chromium >/dev/null 2>&1; then
        exec omarchy-chromium "$url"
    fi
    exec omarchy-browser "$url"
fi
exec omarchy-browser --app="$url"
