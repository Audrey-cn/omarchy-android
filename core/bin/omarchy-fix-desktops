#!/usr/bin/env python3
"""Publish missing project launchers in XDG system-local applications only."""

import os
import tempfile
from pathlib import Path

LAUNCHERS = [
    (
        "cc-switch",
        "CC Switch",
        "/usr/bin/cc-switch",
        "/usr/local/bin/cc-switch-launch",
        (
            "/usr/share/icons/hicolor/256x256/apps/cc-switch.png",
            "/usr/share/icons/hicolor/128x128/apps/cc-switch.png",
            "/usr/share/icons/hicolor/scalable/apps/cc-switch.svg",
            "cc-switch",
        ),
    ),
    (
        "chatgpt",
        "ChatGPT",
        "/usr/bin/chatgpt",
        "/usr/local/bin/chatgpt-launch %u",
        (
            "/usr/share/icons/hicolor/512x512/apps/chatgpt.png",
            "/usr/share/icons/hicolor/256x256/apps/chatgpt.png",
            "/usr/share/pixmaps/chatgpt.png",
            "chatgpt",
        ),
    ),
    (
        "claude",
        "Claude Desktop",
        "/usr/bin/claude-desktop",
        "/usr/local/bin/claude-desktop-launch %u",
        (
            "/usr/share/icons/hicolor/512x512/apps/claude-desktop.png",
            "/usr/share/icons/hicolor/256x256/apps/claude-desktop.png",
            "/usr/share/pixmaps/claude-desktop.png",
            "claude-desktop",
        ),
    ),
    (
        "hermes",
        "Hermes Desktop",
        "/opt/hermes-desktop/Hermes",
        "/usr/local/bin/hermes-desktop-launch %u",
