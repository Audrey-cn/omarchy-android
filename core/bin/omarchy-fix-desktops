#!/usr/bin/env python3
"""Publish missing project launchers in XDG system-local applications only."""

import os
import tempfile
from pathlib import Path

LAUNCHERS = [
    ("cc-switch", "CC Switch", "/usr/bin/cc-switch", "/usr/local/bin/cc-switch-launch"),
    ("chatgpt", "ChatGPT", "/usr/bin/chatgpt", "/usr/local/bin/chatgpt-launch %u"),
    (
        "claude",
        "Claude Desktop",
        "/usr/bin/claude-desktop",
        "/usr/local/bin/claude-desktop-launch %u",
    ),
    (
        "hermes",
        "Hermes Desktop",
        "/opt/hermes-desktop/Hermes",
        "/usr/local/bin/hermes-desktop-launch %u",
    ),
    (
        "code",
        "Visual Studio Code",
        "/usr/share/code/code",
        "/usr/share/code/code --no-sandbox --disable-dev-shm-usage --in-process-gpu --disable-gpu-compositing --ozone-platform=wayland --enable-wayland-ime --password-store=basic %F",
    ),
]


def publish(directory, slug, name, executable, command):
    if not os.access(executable, os.X_OK) or not os.access(command.split()[0], os.X_OK):
        return
    directory.mkdir(parents=True, exist_ok=True)
    target = directory / f"omarchy-android-{slug}.desktop"
    if os.path.lexists(target):
        return
    with tempfile.NamedTemporaryFile(dir=directory, mode="w") as staged:
        staged.write(
            f"[Desktop Entry]\nType=Application\nName={name} (Omarchy)\n"
            f"TryExec={executable}\nExec={command}\nTerminal=false\nCategories=Utility;\n"
        )
        staged.flush()
        os.chmod(staged.name, 0o644)
        try:
            os.link(staged.name, target)
        except FileExistsError:
            pass


if __name__ == "__main__":
    for item in LAUNCHERS:
        publish(Path("/usr/local/share/applications"), *item)
