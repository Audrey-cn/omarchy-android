    (
        "code",
        "Visual Studio Code",
        "/usr/share/code/code",
        "/usr/share/code/code --no-sandbox --disable-dev-shm-usage --in-process-gpu --disable-gpu-compositing --ozone-platform=wayland --enable-wayland-ime --password-store=basic %F",
        (
            "/usr/share/pixmaps/vscode.png",
            "/usr/share/icons/hicolor/512x512/apps/vscode.png",
            "/usr/share/code/resources/app/resources/linux/code.png",
            "vscode",
        ),
    ),
]

VENDOR_DESKTOPS = {
    "cc-switch": (
        "/usr/share/applications/CC Switch.desktop",
        "/usr/share/applications/cc-switch.desktop",
        "/usr/share/applications/CC-Switch.desktop",
    ),
    "chatgpt": ("/usr/share/applications/chatgpt.desktop",),
    "claude": ("/usr/share/applications/claude-desktop.desktop",),
    "hermes": ("/usr/share/applications/hermes-desktop.desktop",),
    "code": ("/usr/share/applications/code.desktop",),
}


def resolve_icon(slug, candidates=(), executable=""):
    scan_paths = list(VENDOR_DESKTOPS.get(slug, ()))
    exec_base = os.path.basename(executable).lower() if executable else ""
    vendor_dir = Path("/usr/share/applications")
    if exec_base and vendor_dir.is_dir():
        for entry in sorted(vendor_dir.glob("*.desktop")):
            if str(entry) not in scan_paths:
                try:
                    txt = entry.read_text(errors="ignore")
                except OSError:
                    continue
                if exec_base in txt.lower():
                    scan_paths.append(str(entry))
    for desktop_path in scan_paths:
        path = Path(desktop_path)
        if path.is_file():
            try:
                for line in path.read_text(errors="ignore").splitlines():
                    if line.startswith("Icon=") and line[5:].strip():
                        val = line[5:].strip()
                        if not os.path.isabs(val) or os.path.isfile(val):
                            return val
            except OSError:
                pass
    fallback_name = None
    for cand in candidates:
        if os.path.isabs(cand):
            if os.path.isfile(cand):
                return cand
        elif fallback_name is None:
            fallback_name = cand
    return fallback_name


def publish(directory, slug, name, executable, command, icons=()):
    if not os.access(executable, os.X_OK) or not os.access(command.split()[0], os.X_OK):
        return
    directory.mkdir(parents=True, exist_ok=True)
    target = directory / f"omarchy-android-{slug}.desktop"
    icon = resolve_icon(slug, icons, executable)
    icon_line = f"Icon={icon}\n" if icon else ""
    body = (
        f"[Desktop Entry]\nType=Application\nName={name} (Omarchy)\n"
        f"TryExec={executable}\nExec={command}\n{icon_line}Terminal=false\nCategories=Utility;\n"
    )
    if os.path.lexists(target):
        # Upgrade legacy project-generated entries that omitted Icon=, while preserving user edits.
        # Under proot --link2symlink, os.link() produces a symlink to .proot.l2s.*; treat it as a regular file.
        is_proot_l2s = target.is_symlink() and ".proot.l2s." in os.readlink(target)
        if icon and target.is_file() and (not target.is_symlink() or is_proot_l2s):
            try:
                existing = target.read_text(errors="ignore")
            except OSError:
                return
            legacy = (
                f"[Desktop Entry]\nType=Application\nName={name} (Omarchy)\n"
                f"TryExec={executable}\nExec={command}\nTerminal=false\nCategories=Utility;\n"
            )
            if existing == legacy or (
                f"Name={name} (Omarchy)\n" in existing
                and f"TryExec={executable}\n" in existing
                and "\nIcon=" not in existing
            ):
                with tempfile.NamedTemporaryFile(dir=directory, mode="w", delete=False) as staged:
                    staged.write(body)
                    staged.flush()
                    os.chmod(staged.name, 0o644)
                    os.replace(staged.name, target)
        return
    with tempfile.NamedTemporaryFile(dir=directory, mode="w", delete=False) as staged:
        staged.write(body)
        staged.flush()
        os.chmod(staged.name, 0o644)
        os.replace(staged.name, target)


if __name__ == "__main__":
    for item in LAUNCHERS:
        publish(Path("/usr/local/share/applications"), *item)
