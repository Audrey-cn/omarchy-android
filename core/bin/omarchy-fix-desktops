            "/opt/hermes-desktop/resources/app.asar.unpacked/dist/apple-touch-icon.png",
            "/usr/share/icons/hicolor/512x512/apps/hermes-desktop.png",
            "/usr/share/icons/hicolor/256x256/apps/hermes-desktop.png",
            "/usr/share/pixmaps/hermes-desktop.png",
            "/opt/hermes-desktop/resources/icon.png",
            "/opt/hermes-desktop/resources/app.asar.unpacked/dist/icon.png",
            "/opt/hermes-desktop/resources/app.asar.unpacked/assets/icon.png",
