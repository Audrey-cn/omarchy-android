#!/usr/bin/env python3
"""
Official Omarchy Menu & App Grid Engine (zh-CN / Multilingual)
Directly parses /root/.local/share/omarchy/default/omarchy/omarchy-menu.jsonc
and /root/.local/share/omarchy/default/i18n/zh-CN/menu.json so that EVERY single
official Omarchy menu item (Apps Grid, Agent/智能体, Appearance/外观, Trigger/触发,
Setup/设置 -> Security/安全 -> 免密 sudo & 免 sudo Docker, Install/安装 -> AI/开发/
服务/编辑器/终端/样式/预装应用, Remove/移除, Update/更新, Learn/学习, System/系统)
is 100% present and localized in Chinese!
"""
import os
import re
import sys
import glob
import json
import subprocess

OMARCHY_PATH = "/root/.local/share/omarchy"
STATE_DIR = "/root/.local/state/omarchy/current"
MENU_JSONC = f"{OMARCHY_PATH}/default/omarchy/omarchy-menu.jsonc"
I18N_ZH = f"{OMARCHY_PATH}/default/i18n/zh-CN/menu.json"

def get_swaysock():
    socks = sorted(glob.glob("/tmp/sway-ipc.*.sock"), key=os.path.getmtime, reverse=True)
    return socks[0] if socks else "/tmp/sway-ipc.sock"

def wl_env():
    return {
        **os.environ,
        "OMARCHY_PATH": OMARCHY_PATH,
        "PATH": f"{OMARCHY_PATH}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "XDG_RUNTIME_DIR": "/tmp",
        "WAYLAND_DISPLAY": "wayland-1",
        "SWAYSOCK": get_swaysock(),
        "DISPLAY": ":0",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
    }

def load_menu_data():
    with open(MENU_JSONC, "r", encoding="utf-8") as f:
        txt = f.read()
    txt = re.sub(r"^\s*//.*$", "", txt, flags=re.M)
    txt = re.sub(r",(\s*[}\]])", r"\1", txt)
    menu = json.loads(txt)
    zh = {}
    if os.path.exists(I18N_ZH):
        with open(I18N_ZH, "r", encoding="utf-8") as f:
            zh = json.load(f)
    return menu, zh

def kill_wofi():
    subprocess.run("for p in $(pidof wofi 2>/dev/null); do kill -9 $p 2>/dev/null; done", shell=True)

def wofi_pick(prompt, rows, width=330, height=380, columns=1):
    kill_wofi()
    inp = "\n".join(rows)
    cmd = [
        "wofi", "--dmenu", "--insensitive",
        "--prompt", prompt,
        "--width", str(width),
        "--height", str(height),
        "--columns", str(columns),
        "--style", "/root/.config/wofi/style.css",
        "--cache-file", "/dev/null"
    ]
    p = subprocess.run(cmd, input=inp, text=True, capture_output=True, env=wl_env())
    return p.stdout.strip()

def show_app_grid():
    kill_wofi()
    env = wl_env()
    env["GDK_BACKEND"] = "wayland"
    subprocess.Popen(["/usr/local/bin/omarchy-app-grid"], env=env)

def run_in_terminal(title, shell_cmd):
    script = f"clear; echo '=== {title} ==='; echo ''; {shell_cmd}; echo ''; read -n 1 -s -r -p '按任意键关闭 (Press any key to close)...'"
    subprocess.Popen(["alacritty", "-e", "bash", "-c", script], env=wl_env())

def handle_special_route(route):
    if route == "apps":
        show_app_grid()
        return True
    if route == "appearance.theme":
        kill_wofi()
        env = wl_env()
        env["GDK_BACKEND"] = "wayland"
        subprocess.Popen(["/usr/local/bin/omarchy-image-picker", "theme"], env=env)
        return True
    if route == "appearance.background":
        kill_wofi()
        env = wl_env()
        env["GDK_BACKEND"] = "wayland"
        subprocess.Popen(["/usr/local/bin/omarchy-image-picker", "background"], env=env)
        return True
    if route == "learn.keybindings":
        binds = [
            "Alt / Super + Space          →  原生 6 列应用网格 (App Grid)",
            "Alt + M / Super+Alt+Space    →  Omarchy 中文主菜单 (前往…)",
            "Alt / Super + I              →  切换中英文拼音输入法 (EN ↔ 拼)",
            "Alt / Super + Enter          →  打开 Alacritty 终端",
            "Alt / Super + W / Q          →  关闭当前窗口 (Close Window)",
            "Alt / Super + K              →  快捷键速查表 (Keybindings)",
            "Alt / Super + J              →  切换分屏方向 (Toggle Split)",
            "Alt / Super + T              →  切换浮动 / 平铺 (Toggle Floating)",
            "Alt / Super + F              →  切换全屏 (Fullscreen)",
            "Alt / Super + 方向键         →  切换窗口焦点 (加 Shift 移动窗口)",
            "Alt / Super + 1..5           →  切换工作区 1..5 (加 Shift 移动窗口)",
            "Alt / Super + Tab            →  切换下一个工作区",
            "Alt / Super + Ctrl + R       →  循环切换触控板方向 (0/90/180/270°)",
            "Alt / Super + Shift + Space  →  切换下一张主题壁纸",
            "Alt / Super + Escape         →  系统菜单 (System)"
        ]
        wofi_pick("  快捷键 (Keybindings)…", binds, 540, 440)
        return True
    return False

def execute_item_action(key, item, zh_label):
    action = item.get("action", "")
    # 1. Security & Setup (Unified with Waybar indicator!)
    if key == "setup.security.passwordless-sudo":
        os.makedirs("/etc/sudoers.d", exist_ok=True)
        pfile = "/etc/sudoers.d/omarchy-nopasswd"
        if os.path.exists(pfile):
            os.remove(pfile)
            subprocess.run("pkill -RTMIN+10 waybar 2>/dev/null || true", shell=True)
            run_in_terminal("免密 sudo (Passwordless Sudo)", "echo '已关闭免密 sudo (Passwordless Sudo Disabled).'")
        else:
            with open(pfile, "w") as f:
                f.write("ALL ALL=(ALL) NOPASSWD: ALL\n")
            os.chmod(pfile, 0o440)
            subprocess.run("pkill -RTMIN+10 waybar 2>/dev/null || true", shell=True)
            run_in_terminal("免密 sudo (Passwordless Sudo)", "echo '✓ 已启用免密 sudo (/etc/sudoers.d/omarchy-nopasswd)!'")
        return
    if key == "setup.security.sudoless-docker":
        run_in_terminal("免 sudo Docker (Sudoless Docker)", "groupadd -f docker && usermod -aG docker root && echo '✓ 已配置免 sudo Docker 用户组!'")
        return
    if key == "setup.security.sshd":
        run_in_terminal("SSHD 服务管理", "mkdir -p /run/sshd && /usr/sbin/sshd 2>/dev/null || true; echo '✓ SSHD 状态:'; ps aux | grep sshd | grep -v grep")
        return
    if key == "setup.security.ssh-agent":
        run_in_terminal("SSH Agent", "eval $(ssh-agent -s) && ssh-add -l || true")
        return
    if key.startswith("setup.network") or key.startswith("trigger.hardware.network"):
        subprocess.Popen(["/usr/local/bin/omarchy-panel", "network"], env={**wl_env(), "GDK_BACKEND": "wayland"})
        return
    if key.startswith("setup.audio") or key.startswith("trigger.hardware.audio"):
        subprocess.Popen(["/usr/local/bin/omarchy-panel", "audio"], env={**wl_env(), "GDK_BACKEND": "wayland"})
        return
    if key.startswith("setup.bluetooth") or key.startswith("trigger.hardware.bluetooth"):
        subprocess.Popen(["/usr/local/bin/omarchy-panel", "bluetooth"], env={**wl_env(), "GDK_BACKEND": "wayland"})
        return
    if key.startswith("setup.monitor") or key.startswith("trigger.hardware.display"):
        subprocess.Popen(["/usr/local/bin/omarchy-panel", "monitor"], env={**wl_env(), "GDK_BACKEND": "wayland"})
        return
    if key.startswith("setup.keyboard") or key.startswith("setup.input"):
        subprocess.Popen(["fcitx5-configtool"], env={**wl_env(), "DBUS_SESSION_BUS_ADDRESS": "unix:path=/tmp/omarchy-dbus.sock"})
        return

    # 2. Trigger (Capture / Toggles)
    if key.startswith("trigger.capture.screenshot"):
        os.makedirs("/mnt/sdcard/Pictures", exist_ok=True)
        out = f"/mnt/sdcard/Pictures/omarchy-$(date +%Y%m%d-%H%M%S).png"
        if "region" in key or "area" in key:
            subprocess.Popen(["bash", "-c", f'g=$(slurp); [ -n "$g" ] && grim -g "$g" "{out}" && notify-send "已区域截屏" "{out}"'], env=wl_env())
        else:
            subprocess.Popen(["bash", "-c", f'grim "{out}" && notify-send "已全屏截屏" "{out}"'], env=wl_env())
        return
    if key.startswith("trigger.toggle.notifications"):
        subprocess.Popen(["/usr/local/bin/omarchy-indicator", "toggle", "dnd"], env=wl_env())
        return
    if key.startswith("trigger.toggle.nightlight"):
        subprocess.Popen(["/usr/local/bin/omarchy-indicator", "toggle", "night"], env=wl_env())
        return
    if key.startswith("trigger.toggle.idle"):
        subprocess.Popen(["/usr/local/bin/omarchy-indicator", "toggle", "awake"], env=wl_env())
        return

    # 3. Appearance (Top Bar Background / Position / Hide / Gaps)
    if key.startswith("appearance.top-bar.hide") or key.startswith("appearance.top-bar.show"):
        if subprocess.run("pidof waybar", shell=True, stdout=subprocess.DEVNULL).returncode == 0:
            subprocess.run("for p in $(pidof waybar); do kill -9 $p; done", shell=True)
        else:
            subprocess.Popen(["/usr/local/bin/launch-waybar"], env=wl_env())
        return
    if key.startswith("appearance.top-bar.background."):
        style_mode = key.rsplit(".", 1)[-1]
        css_p = "/root/.config/waybar/style.css"
        if os.path.exists(css_p):
            css = open(css_p, encoding="utf-8").read()
            css = re.sub(r"\n/\* BAR_BG_OVERRIDE \*/[\s\S]*?/\* END_BAR_BG_OVERRIDE \*/", "", css)
            if style_mode == "clear":
                bg_rule = "window#waybar { background-color: transparent; }"
            elif style_mode == "glassy":
                bg_rule = "window#waybar { background-color: alpha(@background, 0.72); }"
            else:
                bg_rule = "window#waybar { background-color: @background; }"
            css += f"\n/* BAR_BG_OVERRIDE */\n{bg_rule}\n/* END_BAR_BG_OVERRIDE */\n"
            open(css_p, "w", encoding="utf-8").write(css)
            subprocess.Popen(["/usr/local/bin/launch-waybar"], env=wl_env())
        return
    if key.startswith("appearance.top-bar.position."):
        pos = "bottom" if "bottom" in key else "top"
        wb_p = "/root/.config/waybar/config.jsonc"
        if os.path.exists(wb_p):
            wb = json.load(open(wb_p, encoding="utf-8"))
            wb["position"] = pos
            json.dump(wb, open(wb_p, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
            subprocess.Popen(["/usr/local/bin/launch-waybar"], env=wl_env())
        return
    if key.startswith("appearance.windows.gaps"):
        subprocess.run(["swaymsg", "gaps inner all toggle 5; gaps outer all toggle 10"], env=wl_env())
        return

    # 4. System Actions (Android-safe)
    if key == "system.about":
        run_in_terminal("关于 Omarchy (About)", f"cat {OMARCHY_PATH}/logo.txt; echo ''; fastfetch")
        return
    if key == "system.screensaver":
        subprocess.Popen(["alacritty", "-e", "btop", "--utf-force"], env=wl_env())
        return
    if key in ("system.logout", "system.lock", "system.suspend", "system.hibernate"):
        subprocess.Popen(["am", "start", "-a", "android.intent.action.MAIN", "-c", "android.intent.category.HOME"])
        return
    if key == "system.reboot":
        subprocess.Popen(["/data/adb/start-omarchy.sh"])
        return

    # 5. Install, Update, Remove (Native Ubuntu ARM64!)
    if key.startswith("install."):
        run_in_terminal(f"安装 (Install): {zh_label}", f"/usr/local/bin/omarchy-installer.sh '{key}' '{zh_label}'")
        return
    if key.startswith("remove."):
        if key == "remove.package":
            cmd = "pkg=$(dpkg-query -W -f='${Package}\\n' | sort | fzf --prompt='选择要卸载的软件包 > '); [ -n \"$pkg\" ] && DEBIAN_FRONTEND=noninteractive apt-get remove -y \"$pkg\" && echo \"✓ 已卸载 $pkg\""
        elif key == "remove.webapp":
            cmd = "f=$(ls /root/.local/share/applications/*.desktop 2>/dev/null | fzf --prompt='选择要移除的桌面应用 > '); [ -n \"$f\" ] && rm -f \"$f\" && echo \"✓ 已移除 $f\""
        elif key == "remove.ai.claude":
            cmd = "DEBIAN_FRONTEND=noninteractive apt-get remove -y claude-desktop && echo '✓ 已卸载 Claude Desktop'"
        elif key == "remove.ai.chatgpt":
            cmd = "DEBIAN_FRONTEND=noninteractive apt-get remove -y chatgpt && echo '✓ 已卸载 Codex / ChatGPT Desktop'"
        elif key == "remove.ai.hermes":
            cmd = "rm -rf /opt/hermes-desktop /usr/share/applications/hermes-desktop.desktop /usr/local/bin/hermes-desktop-launch && echo '✓ 已卸载 Hermes Desktop'"
        else:
            cmd = f"echo '正在检查移除项: {zh_label} ({key})'; f=$(ls /root/.local/share/applications/*.desktop 2>/dev/null | fzf --prompt='选择要移除的应用 > '); [ -n \"$f\" ] && rm -f \"$f\" && echo \"✓ 已移除 $f\""
        run_in_terminal(f"移除 (Remove): {zh_label}", cmd)
        return
    if key.startswith("update."):
        upd_cmd = (
            "if bash -c '</dev/tcp/127.0.0.1/18888' 2>/dev/null; then "
            "export http_proxy=http://127.0.0.1:18888 https_proxy=http://127.0.0.1:18888; fi; "
            "echo '[1/3] 同步官方 basecamp/omarchy 仓库...'; "
            "git -C /root/.local/share/omarchy pull --ff-only || true; "
            "echo ''; echo '[2/3] 更新 Ubuntu 24.04 ARM64 软件包...'; "
            "DEBIAN_FRONTEND=noninteractive apt-get update && DEBIAN_FRONTEND=noninteractive apt-get upgrade -y && apt-get autoremove -y; "
            "echo ''; echo '[3/3] 刷新桌面状态栏...'; "
            "/usr/local/bin/launch-waybar >/dev/null 2>&1 & "
            "echo '✓ Omarchy (Ubuntu ARM64) 更新完成！'"
        )
        run_in_terminal(f"更新 (Update): {zh_label}", upd_cmd)
        return

    # 6. Learn / WebApps / Manual
    if key == "learn.omarchy":
        subprocess.Popen(["/usr/local/bin/omarchy-chromium", "--app=https://learn.omacom.io/2/the-omarchy-manual"], env=wl_env())
        return
    if action:
        if "omarchy-launch-webapp" in action:
            m = re.search(r"https?://[^\s'\"]+", action)
            if m:
                subprocess.Popen(["/usr/local/bin/omarchy-chromium", f"--app={m.group(0)}"], env=wl_env())
                return
        if "omarchy-launch-floating-terminal" in action or "xdg-terminal-exec" in action:
            inner = action.replace("omarchy-launch-floating-terminal-with-presentation", "").replace("xdg-terminal-exec --app-id=org.omarchy.terminal", "").strip().strip("'").strip('"')
            run_in_terminal(zh_label, inner)
        elif "omarchy-launch-editor" in action:
            target = action.replace("omarchy-launch-editor", "").strip().strip('"').strip("'")
            subprocess.Popen(["alacritty", "-e", "nvim", os.path.expandvars(target)], env=wl_env())
        else:
            run_in_terminal(zh_label, action)

def navigate_menu(route="root"):
    menu, zh = load_menu_data()
    if handle_special_route(route):
        return

    # Find direct children of `route`
    children = []
    if route == "root":
        for k, v in menu.items():
            if "." not in k:
                children.append((k, v))
        prompt = f"{zh.get('root', {}).get('label', '前往')} (Go)…"
    else:
        prefix = route + "."
        for k, v in menu.items():
            if k.startswith(prefix):
                rem = k[len(prefix):]
                if "." not in rem:
                    children.append((k, v))
        ztitle = zh.get(route, {}).get("title") or zh.get(route, {}).get("label") or menu.get(route, {}).get("label", route)
        prompt = f"{ztitle}…"

    if not children:
        if route in menu:
            zlabel = zh.get(route, {}).get("label", menu[route].get("label", route))
            execute_item_action(route, menu[route], zlabel)
        return

    rows = []
    row_map = {}
    for k, v in children:
        icon = v.get("icon", "󰄾")
        en_label = v.get("label", k)
        zh_label = zh.get(k, {}).get("label", en_label)
        if zh_label != en_label:
            disp = f"{icon}  {zh_label} ({en_label})"
        else:
            disp = f"{icon}  {zh_label}"
        # Append checkmark if passwordless sudo is active
        if k == "setup.security.passwordless-sudo" and os.path.exists("/etc/sudoers.d/omarchy-nopasswd"):
            disp += "  ✓"
        rows.append(disp)
        row_map[disp] = (k, v, zh_label)

    if route != "root":
        back_row = "󰁍  返回上一级 (Back)"
        rows.append(back_row)

    ans = wofi_pick(prompt, rows, 370, min(480, 115 + len(rows) * 38))
    if not ans:
        return
    if ans == "󰁍  返回上一级 (Back)":
        parent = route.rsplit(".", 1)[0] if "." in route else "root"
        navigate_menu(parent)
        return
    if ans in row_map:
        ckey, citem, czh = row_map[ans]
        if handle_special_route(ckey):
            return
        # Check if ckey has sub-items
        has_sub = any(mk.startswith(ckey + ".") for mk in menu.keys())
        if has_sub:
            navigate_menu(ckey)
        else:
            execute_item_action(ckey, citem, czh)

if __name__ == "__main__":
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if not arg:
        # Toggle off if wofi is already open
        if subprocess.run("pidof wofi", shell=True, stdout=subprocess.DEVNULL).returncode == 0:
            kill_wofi()
            sys.exit(0)
        navigate_menu("root")
    elif arg in ("apps", "walker", "grid"):
        if subprocess.run("pidof wofi", shell=True, stdout=subprocess.DEVNULL).returncode == 0:
            kill_wofi()
            sys.exit(0)
        show_app_grid()
    elif arg == "style":
        navigate_menu("appearance")
    elif arg == "theme":
        navigate_menu("appearance.theme")
    elif arg == "background":
        navigate_menu("appearance.background")
    elif arg == "setup":
        navigate_menu("setup")
    elif arg == "install":
        navigate_menu("install")
    elif arg == "trigger":
        navigate_menu("trigger")
    elif arg == "keybindings":
        navigate_menu("learn.keybindings")
    elif arg == "system":
        navigate_menu("system")
    else:
        navigate_menu(arg)
