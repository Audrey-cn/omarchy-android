#!/bin/bash
for p in $(pidof waybar polybar 2>/dev/null); do kill -9 "$p" 2>/dev/null; done
sleep 0.2
DBUS_SESSION_BUS_ADDRESS="unix:path=/tmp/omarchy-dbus.sock" \
XDG_RUNTIME_DIR=/tmp \
WAYLAND_DISPLAY=wayland-1 \
SWAYSOCK=$(ls -t /tmp/sway-ipc.*.sock 2>/dev/null | head -n 1) \
nohup waybar -c /root/.config/waybar/config.jsonc -s /root/.config/waybar/style.css >/tmp/waybar.log 2>&1 &
