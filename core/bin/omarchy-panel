        self.upd_desk_status = Gtk.Label(label="未检查", xalign=1)
        c1_top.pack_end(self.upd_desk_status, False, False, 0)
        c1.pack_start(c1_top, False, False, 0)
        c1_bot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        c1_sub = Gtk.Label(label="界面、顶栏、控制面板与配套组件", xalign=0)
        c1_sub.get_style_context().add_class("panel-dim")
        c1_bot.pack_start(c1_sub, True, True, 0)
        self.upd_desk_btn = Gtk.Button(label="更新")
        self.upd_desk_btn.get_style_context().add_class("panel-btn")
        self.upd_desk_btn.connect(
            "clicked",
            lambda _: self._run_update_terminal(
                "更新 Omarchy 桌面环境", "/usr/local/bin/omarchy-updates apply desktop"
            ),
        )
        c1_bot.pack_end(self.upd_desk_btn, False, False, 0)
        c1.pack_start(c1_bot, False, False, 0)
        self.box.pack_start(c1, False, False, 0)

        # Card 2: Linux System Packages (APT)
        c2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        c2.get_style_context().add_class("update-card")
        c2_top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
