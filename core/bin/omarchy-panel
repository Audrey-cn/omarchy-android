        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.box.get_style_context().add_class("panel-box")
        self.add(self.box)

        if mode == "calendar":
            self.build_calendar()
        elif mode == "audio":
            self.build_audio()
        elif mode == "monitor":
            self.build_monitor()
        elif mode == "network":
            self.build_network()
        elif mode == "bluetooth":
            self.build_bluetooth()
        elif mode == "keyboard":
            self.build_keyboard()
        elif mode == "power":
            self.build_power()
        elif mode == "agents":
            self.build_agents()
        elif mode == "update":
            self.build_update()
        else:
            self.add_title("Omarchy 面板")

        self.connect("key-press-event", self.on_key)
        self.connect("destroy", Gtk.main_quit)
        # Pre-layout & realize before mapping so Wayland commits ONE final-size frame (zero small-window flash!)
        self.box.show_all()
        self.realize()
        self.show()

    def add_title(self, text):
        l = Gtk.Label(label=text, xalign=0)
        l.get_style_context().add_class("panel-title")
        self.box.pack_start(l, False, False, 0)

    def add_row(self, text, dim=False):
        l = Gtk.Label(label=text, xalign=0)
        l.get_style_context().add_class("panel-dim" if dim else "panel-row")
        l.set_line_wrap(True)
        self.box.pack_start(l, False, False, 0)
        return l

    def add_btn(self, label, cb):
        b = Gtk.Button(label=label)
        b.get_style_context().add_class("om-btn")
        b.connect("clicked", cb)
        self.box.pack_start(b, False, False, 0)
        return b

    def build_calendar(self):
        self.set_size_request(320, -1)
        self.add_title("󰃭  日历 (Calendar)")
        cal = Gtk.Calendar()
        cal.set_display_options(
            Gtk.CalendarDisplayOptions.SHOW_HEADING
            | Gtk.CalendarDisplayOptions.SHOW_DAY_NAMES
            | Gtk.CalendarDisplayOptions.SHOW_WEEK_NUMBERS
        )
        self.box.pack_start(cal, True, True, 0)

    def build_audio(self):
        self.set_size_request(310, -1)
        self.add_title("󰕾  音频控制 (Audio)")
        cur_vol = 60
        out = sh("pactl get-sink-volume @DEFAULT_SINK@")
        m = re.search(r"(\d+)%", out)
        if m:
            cur_vol = min(150, int(m.group(1)))
        lbl = self.add_row(f"主音量: {cur_vol}%")
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 120, 5)
        scale.set_value(cur_vol)
        scale.set_draw_value(False)

        def on_vol(s):
            v = int(s.get_value())
            lbl.set_text(f"主音量: {v}%")
            launch_bg(f"pactl set-sink-volume @DEFAULT_SINK@ {v}%; /usr/local/bin/omarchy_session.py signal waybar 8")

        scale.connect("value-changed", on_vol)
        self.box.pack_start(scale, False, False, 4)

        def on_mute(_):
            launch_bg("pactl set-sink-mute @DEFAULT_SINK@ toggle; /usr/local/bin/omarchy_session.py signal waybar 8")
            Gtk.main_quit()

        self.add_btn("󰝟  静音 / 取消静音", on_mute)

    def detect_display(self):
        out_name, pw, ph, cur_scale = "X11-1", 2336, 1080, 1.25
        try:
            raw = sh(f"SWAYSOCK={get_swaysock()} swaymsg -t get_outputs")
            outs = json.loads(raw)
            if outs:
                o = outs[0]
                out_name = o.get("name", out_name)
                cm = o.get("current_mode") or {}
                pw = int(cm.get("width", pw))
                ph = int(cm.get("height", ph))
                cur_scale = float(o.get("scale", cur_scale))
        except Exception:
            pass
        # Compute human-readable aspect ratio
        short_s, long_s = min(pw, ph), max(pw, ph)
        ratio = round(long_s / short_s, 2) if short_s else 1.78
        if abs(ratio - 1.78) < 0.06:
            ar_str = "16:9"
        elif abs(ratio - 1.60) < 0.06:
            ar_str = "16:10"
        elif abs(ratio - 1.33) < 0.06:
            ar_str = "4:3"
        elif abs(ratio - 2.16) < 0.08:
            ar_str = "19.5:9"
        elif abs(ratio - 2.22) < 0.08:
            ar_str = "20:9"
        else:
            ar_str = f"{ratio}:1"
        # Smart recommended scale
        if short_s <= 1080 and long_s >= 2100:
            rec = 1.25
        elif short_s >= 1400:
            rec = 1.50
        else:
            rec = 1.00
        return out_name, pw, ph, ar_str, cur_scale, rec

    def apply_scale(self, val):
        val = max(0.70, min(2.50, round(float(val), 2)))
        os.makedirs(os.path.dirname(SCALE_FILE), exist_ok=True)
        open(SCALE_FILE, "w").write(f"{val:.2f}")
        launch_bg(f"swaymsg 'output {self._out_name} scale {val:.2f}'")
        self._cur_scale = val
        self.refresh_monitor_ui()

    def build_monitor(self):
        self.set_size_request(360, -1)
        self._out_name, self._pw, self._ph, self._ar, self._cur_scale, self._rec = self.detect_display()
        self.add_title("󰃠  显示与缩放 (Monitor)")
        self.mon_info = self.add_row("")
        self.mon_logical = self.add_row("", dim=True)

        grid = Gtk.Grid(column_spacing=6, row_spacing=6)
        grid.set_column_homogeneous(True)
        self.scale_btns = {}
        presets = [0.85, 1.00, 1.15, 1.25, 1.35, 1.50, 1.75, 2.00]
        for i, sc in enumerate(presets):
            tag = " ★" if abs(sc - self._rec) < 0.01 else ""
            b = Gtk.Button(label=f"{sc:g}x{tag}")
            b.connect("clicked", lambda _, s=sc: self.apply_scale(s))
            grid.attach(b, i % 4, i // 4, 1, 1)
            self.scale_btns[sc] = b
        self.box.pack_start(grid, False, False, 4)

        fbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        b_dec = Gtk.Button(label="− 0.05x")
        b_dec.get_style_context().add_class("om-btn")
        b_dec.connect("clicked", lambda _: self.apply_scale(self._cur_scale - 0.05))
        b_rec = Gtk.Button(label=f"恢复推荐 ({self._rec:g}x)")
        b_rec.get_style_context().add_class("om-btn")
        b_rec.connect("clicked", lambda _: self.apply_scale(self._rec))
        b_inc = Gtk.Button(label="+ 0.05x")
        b_inc.get_style_context().add_class("om-btn")
        b_inc.connect("clicked", lambda _: self.apply_scale(self._cur_scale + 0.05))
        fbox.pack_start(b_dec, True, True, 0)
        fbox.pack_start(b_rec, True, True, 0)
        fbox.pack_start(b_inc, True, True, 0)
        self.box.pack_start(fbox, False, False, 0)

        # Symmetrical R-corner safe margin slider for Waybar (0-64px)
        self.inset_title = self.add_row("圆角屏安全边距 (状态栏左右内缩): 30 px", dim=True)
        sbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.inset_scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 64, 2)
        self.inset_scale.set_draw_value(False)
        self.inset_scale.set_hexpand(True)
        self._inset_syncing = False
        def _on_inset_changed(scale):
            val = int(round(scale.get_value()))
            self.inset_title.set_text(f"圆角屏安全边距 (状态栏左右内缩): {val} px")
        def _on_inset_commit(scale, _event=None):
            if not self._inset_syncing:
                self.apply_bar_inset(int(round(scale.get_value())))
            return False
        self.inset_scale.connect("value-changed", _on_inset_changed)
        self.inset_scale.connect("button-release-event", _on_inset_commit)
        self.inset_scale.connect("key-release-event", _on_inset_commit)
        b_apply_inset = Gtk.Button(label="应用")
        b_apply_inset.get_style_context().add_class("om-btn")
        b_apply_inset.connect("clicked", lambda _: self.apply_bar_inset(int(round(self.inset_scale.get_value()))))
        sbox.pack_start(self.inset_scale, True, True, 0)
        sbox.pack_start(b_apply_inset, False, False, 0)
        self.box.pack_start(sbox, False, False, 0)
        self.refresh_monitor_ui()

    def apply_bar_inset(self, px):
        px = max(0, min(64, int(px)))
        os.makedirs("/root/.config/omarchy", exist_ok=True)
        open("/root/.config/omarchy/bar-inset", "w").write(str(px))
        css_path = "/root/.config/waybar/style.css"
        if os.path.exists(css_path):
            txt = open(css_path, "r", encoding="utf-8").read()
            txt = re.sub(r"margin-left:\s*\d+px;", f"margin-left: {px}px;", txt, count=1)
            txt = re.sub(r"margin-right:\s*\d+px;", f"margin-right: {px}px;", txt, count=1)
            open(css_path, "w", encoding="utf-8").write(txt)
        subprocess.Popen(["/usr/local/bin/launch-waybar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.refresh_monitor_ui()

    def refresh_monitor_ui(self):
        lw = int(round(self._pw / self._cur_scale))
        lh = int(round(self._ph / self._cur_scale))
        self.mon_info.set_text(f"屏幕: {self._pw} × {self._ph} ({self._ar}) · 当前 {self._cur_scale:g}x")
        self.mon_logical.set_text(f"等效逻辑分辨率: {lw} × {lh} · 推荐 {self._rec:g}x (★)")
        for sc, b in self.scale_btns.items():
            bsc = b.get_style_context()
            bsc.remove_class("om-btn")
            bsc.remove_class("om-btn-active")
            bsc.add_class("om-btn-active" if abs(sc - self._cur_scale) < 0.015 else "om-btn")
        cur_inset = 30
        try:
            if os.path.exists("/root/.config/omarchy/bar-inset"):
                cur_inset = max(0, min(64, int(open("/root/.config/omarchy/bar-inset").read().strip())))
        except Exception:
            pass
        self._inset_syncing = True
        self.inset_scale.set_value(cur_inset)
        self.inset_title.set_text(f"圆角屏安全边距 (状态栏左右内缩): {cur_inset} px")
        self._inset_syncing = False

    def build_network(self):
        self.set_size_request(340, -1)
        self.add_title("󰖩  网络状态 (Network)")
        host = load_host_status()
        wlan_ip = get_iface_ip("wlan0")
        cell_ip = ""
        try:
            for name in sorted(os.listdir("/sys/class/net")):
                if name.startswith(("rmnet", "ccmni", "wwan")):
                    cell_ip = get_iface_ip(name)
                    if cell_ip:
                        break
        except Exception:
            pass
        proxy_ok = sh("bash -c '</dev/tcp/127.0.0.1/18888' && echo OK") == "OK"

        if wlan_ip:
            ssid = host.get("wifi_ssid") or "已连接"
            spd = host.get("wifi_speed") or ""
            rssi = host.get("wifi_rssi") or ""
            extra = " · ".join([x for x in (spd, rssi) if x])
            self.add_row(f"Wi-Fi: {ssid}")
            self.add_row(f"局域网 IP: {wlan_ip}" + (f" ({extra})" if extra else ""), dim=True)
        else:
            self.add_row("Wi-Fi: 未连接", dim=True)

        if cell_ip:
            self.add_row(f"移动数据: 已连接 ({cell_ip})", dim=True)
        self.add_row(f"USB 代理隧道: {'已连接 (127.0.0.1:18888)' if proxy_ok else '未连接'}", dim=not proxy_ok)

        self.add_btn("󰖩  切换 Wi-Fi (打开系统 Wi-Fi 设置)", lambda _: (send_host_action("wifi_settings"), Gtk.main_quit()))
        self.add_btn("󰑓  刷新状态栏网络状态", lambda _: (send_host_action("refresh_status"), launch_bg("/usr/local/bin/omarchy_session.py signal waybar 7"), Gtk.main_quit()))

    def build_bluetooth(self):
        self.set_size_request(340, -1)
        self.add_title("󰂯  蓝牙与外设管理 (Bluetooth)")
        host = load_host_status()
        bt_on = bool(host.get("bt_enabled", True))
        m15 = sh("grep -q 'M15' /proc/bus/input/devices && echo '已连接 (evdev 已接管)' || echo '未检测到'")
        rot = sh("cat /root/.config/omarchy/touchpad-rotation 2>/dev/null || echo 0")
        self.add_row(f"系统蓝牙状态: {'已开启 (ON)' if bt_on else '已关闭 (OFF)'}")
        self.add_row(f"外接键盘/触控板: {m15}", dim=True)
        self.add_row(f"触控板旋转角度: {rot}°", dim=True)
        self.add_btn(
            "󰂲  关闭系统蓝牙" if bt_on else "󰂯  开启系统蓝牙",
            lambda _: (send_host_action("bt_disable" if bt_on else "bt_enable"), Gtk.main_quit())
        )
        self.add_btn("󰂰  扫描 / 配对新设备 (系统蓝牙)", lambda _: (send_host_action("bt_settings"), Gtk.main_quit()))
        self.add_btn("  修饰键与按键冲突设置", lambda _: (launch_bg("GDK_BACKEND=wayland /usr/local/bin/omarchy-panel keyboard"), Gtk.main_quit()))
        self.add_btn("󰑐  切换触控板方向 (0/90/180/270°)", lambda _: (launch_bg("python3 -c \"p='/root/.config/omarchy/touchpad-rotation'; c=int(open(p).read().strip()) if __import__('os').path.exists(p) else 0; n={0:90,90:270,270:180,180:0}.get(c,0); open(p,'w').write(str(n))\""), Gtk.main_quit()))

    def load_mod_cfg(self):
        cfg = {"mode": "super+alt", "caps_as_super": False}
        try:
            if os.path.exists(MODIFIER_CFG):
                cfg.update(json.load(open(MODIFIER_CFG, encoding="utf-8")))
        except Exception:
            pass
        return cfg

    def save_mod_cfg(self, cfg):
        os.makedirs(os.path.dirname(MODIFIER_CFG), exist_ok=True)
        with open(MODIFIER_CFG, "w", encoding="utf-8") as f:
            json.dump(cfg, f, indent=2)
        # The theme engine owns the complete Sway config and reloads it cleanly.
        subprocess.run(["/usr/local/bin/omarchy-theme-engine.py", "restore"], check=True)

    def build_keyboard(self):
        self.set_size_request(480, -1)
        self.mod_cfg = self.load_mod_cfg()
        self.has_keygrab = bool(sh("pgrep -f omarchy-keygrab.py"))
        self._last_probe_ts = 0

        try:
            open(KEYPROBE_FLAG, "w").write("1")
        except Exception:
            pass

        self.add_title("  键盘主修饰键与冲突检测 (Keyboard & Modifier)")
        env_txt = "Root 硬件接管 (omarchy-keygrab 运行中)" if self.has_keygrab else "非 Root 模式 (Sway 原生接管)"
        self.add_row(f"当前键盘链路: {env_txt}", dim=True)

        # 1. Primary Modifier Mode Buttons
        self.add_row("1. 选择主功能修饰键 (点击立即生效，无需重启):")
        self.mode_btns = {}
        modes = [
            ("super+alt", "Super + Alt 双主修饰键 (便携键盘推荐)"),
            ("super", "仅 Super (原版 Omarchy · 释放 Alt 给终端/IDE)"),
            ("alt", "仅 Alt (适合无 Super/Win 键的迷你键盘)"),
        ]
        for key, label in modes:
            b = Gtk.Button(label=label)
            b.connect("clicked", lambda _, k=key: self.on_select_mode(k))
            self.box.pack_start(b, False, False, 0)
            self.mode_btns[key] = b

        self.caps_btn = Gtk.Button()
        self.caps_btn.connect("clicked", self.on_toggle_caps)
        self.box.pack_start(self.caps_btn, False, False, 2)

        # 2. Automatic Conflict Diagnostics
        self.diag_lbl = Gtk.Label(xalign=0)
        self.diag_lbl.set_line_wrap(True)
        self.box.pack_start(self.diag_lbl, False, False, 4)

        # 3. Live Key Probe Box
        self.add_row("2. 实时按键探测 (直接按下 Win / Alt / CapsLock 检测):")
        pbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        pbox.get_style_context().add_class("probe-box")
        self.probe_lbl = Gtk.Label(label="等待按键输入…（若按下 Win 键无反应，说明被 Android 拦截或键盘无此键）", xalign=0)
        self.probe_lbl.get_style_context().add_class("panel-dim")
        self.probe_lbl.set_line_wrap(True)
        pbox.pack_start(self.probe_lbl, False, False, 0)
        self.box.pack_start(pbox, False, False, 0)

        # 4. Touchpad Rotation + Fcitx5
        self.add_row("3. 触控板方向与输入法:")
        rbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.rot_btns = {}
        for deg in (0, 90, 180, 270):
            rb = Gtk.Button(label=f"{deg}°")
            rb.connect("clicked", lambda _, d=deg: self.on_select_rot(d))
            rbox.pack_start(rb, True, True, 0)
            self.rot_btns[deg] = rb
        self.box.pack_start(rbox, False, False, 0)

        self.add_btn("󰌌  打开 Fcitx5 中文输入法配置", lambda _: (launch_bg("fcitx5-configtool"), Gtk.main_quit()))

        self.refresh_keyboard_ui()
        self._probe_timer = GLib.timeout_add(120, self.poll_keyprobe)

    def refresh_keyboard_ui(self):
        cur_m = self.mod_cfg.get("mode", "super+alt")
        caps = bool(self.mod_cfg.get("caps_as_super", False))
        for k, b in self.mode_btns.items():
            sc = b.get_style_context()
            sc.remove_class("om-btn")
            sc.remove_class("om-btn-active")
            sc.add_class("om-btn-active" if k == cur_m else "om-btn")

        sc = self.caps_btn.get_style_context()
        sc.remove_class("om-btn")
        sc.remove_class("om-btn-active")
        sc.add_class("om-btn-active" if caps else "om-btn")
        self.caps_btn.set_label(f"{'☑' if caps else '☐'}  附加映射：将 CapsLock 映射为主修饰键 (Super)")

        # Conflict analysis
        dsc = self.diag_lbl.get_style_context()
        dsc.remove_class("warn-text")
        dsc.remove_class("ok-text")
        if cur_m == "super" and not self.has_keygrab:
            dsc.add_class("warn-text")
            self.diag_lbl.set_text("⚠ 冲突提示：当前非 Root 模式下 Android 可能会截获 Super+Space / Tab，建议改用「仅 Alt」或开启 CapsLock 映射。")
        elif cur_m in ("super+alt", "alt"):
            dsc.add_class("ok-text")
            self.diag_lbl.set_text("✓ 已启用 Alt 替代支持（已屏蔽 Electron 菜单栏误触；若在 Neovim/tmux 中频繁使用 Alt 组合键，可切换为「仅 Super」）。")
        else:
            dsc.add_class("ok-text")
            self.diag_lbl.set_text("✓ 纯净原版模式：Alt 键已完全释放给终端与 IDE，由 Root evdev 独占接管 Super 键，无系统冲突。")

        cur_rot = 0
        try:
            cur_rot = int(open("/root/.config/omarchy/touchpad-rotation").read().strip())
        except Exception:
            pass
        for deg, rb in self.rot_btns.items():
            rsc = rb.get_style_context()
            rsc.remove_class("om-btn")
            rsc.remove_class("om-btn-active")
            rsc.add_class("om-btn-active" if deg == cur_rot else "om-btn")

    def on_select_mode(self, mode_key):
        self.mod_cfg["mode"] = mode_key
        self.save_mod_cfg(self.mod_cfg)
        self.refresh_keyboard_ui()

    def on_toggle_caps(self, _):
        self.mod_cfg["caps_as_super"] = not self.mod_cfg.get("caps_as_super", False)
        self.save_mod_cfg(self.mod_cfg)
        self.refresh_keyboard_ui()

    def on_select_rot(self, deg):
        os.makedirs("/root/.config/omarchy", exist_ok=True)
        open("/root/.config/omarchy/touchpad-rotation", "w").write(str(deg))
        self.refresh_keyboard_ui()

    def poll_keyprobe(self):
        try:
            if os.path.exists(KEYPROBE_OUT):
                d = json.load(open(KEYPROBE_OUT, encoding="utf-8"))
                ts = d.get("ts", 0)
                if ts > self._last_probe_ts:
                    self._last_probe_ts = ts
                    kname = d.get("name", "")
                    dev = d.get("dev", "evdev")
                    cur_m = self.mod_cfg.get("mode", "super+alt")
                    caps = self.mod_cfg.get("caps_as_super", False)
                    role = "普通键"
                    if kname in ("KEY_LEFTMETA", "KEY_RIGHTMETA"):
                        role = "当前主修饰键 ✓" if cur_m in ("super", "super+alt") else "透传给应用"
                    elif kname in ("KEY_LEFTALT", "KEY_RIGHTALT"):
                        role = "当前主修饰键 ✓" if cur_m in ("alt", "super+alt") else "已释放给终端/IDE"
                    elif kname == "KEY_CAPSLOCK":
                        role = "映射为主修饰键 ✓" if caps else "映射为 Escape"
                    self.probe_lbl.set_text(f"硬件事件: {kname} ({dev})\n状态: {role}")
        except Exception:
            pass
        return True

    def build_power(self):
        self.set_size_request(310, -1)
        self.add_title("󰁹  电源与系统状态 (Power)")
        cap = sh("cat /sys/class/power_supply/battery/capacity 2>/dev/null || echo 100")
        stat = sh("cat /sys/class/power_supply/battery/status 2>/dev/null || echo Charging")
        mem = sh("free -h | awk '/^Mem:/ {print $3 \" / \" $2}'")
        self.add_row(f"电池电量: {cap}% ({stat})")
        self.add_row(f"内存占用: {mem}", dim=True)
        self.add_btn("󰍛  打开 btop 系统监视器", lambda _: (launch_bg("alacritty -e btop --utf-force"), Gtk.main_quit()))
        self.add_btn("󰐥  打开 Omarchy 系统菜单", lambda _: (launch_bg("/usr/local/bin/omarchy-menu-ui system"), Gtk.main_quit()))

    def build_agents(self):
        self.set_size_request(320, -1)
        self.add_title("󰚩  AI 智能体中心 (Agents)")
        cc_up = "运行中 (127.0.0.1:15721)" if sh("pgrep -x cc-switch") else "未启动"
        self.add_row(f"CC Switch 网关: {cc_up}")
        self.add_row("当前路由: Xiaomi MiMo Token Plan (mimo-v2.6-pro)", dim=True)
        self.add_btn("󰣆  打开 CC Switch", lambda _: (launch_bg("/usr/local/bin/cc-switch-launch"), Gtk.main_quit()))
        self.add_btn("󰚩  打开 Codex Desktop", lambda _: (launch_bg("/usr/local/bin/chatgpt-launch"), Gtk.main_quit()))
        self.add_btn("󰚩  打开 Claude Desktop", lambda _: (launch_bg("/usr/local/bin/claude-desktop-launch"), Gtk.main_quit()))
        self.add_btn("󰚩  打开 Hermes Desktop", lambda _: (launch_bg("/usr/local/bin/hermes-desktop-launch"), Gtk.main_quit()))

    def _run_update_terminal(self, title, cmd):
        script = (
            f"clear; echo '=== {title} ==='; echo ''; {cmd}; "
            "rc=$?; echo ''; "
            "if [ \"$rc\" -eq 0 ]; then echo '✓ 操作已完成'; else echo \"! 操作结束 (退出码: $rc)\"; fi; "
            "read -n 1 -s -r -p '按任意键关闭窗口...'"
        )
        launch_bg(f"alacritty -e bash -c {shlex.quote(script)}")
        Gtk.main_quit()

    def _load_update_rows(self):
        try:
            out = subprocess.check_output(
                ["/usr/local/bin/omarchy-updates", "status", "--json"],
                stderr=subprocess.DEVNULL,
                text=True,
                timeout=5,
            )
            data = json.loads(out)
            return data if isinstance(data, dict) else {}
        except Exception:
            return {}

    def _fmt_checked_at(self, rows):
        stamps = []
        for k in ("desktop", "apt"):
            ts = (rows.get(k) or {}).get("checked_at")
            if ts:
                try:
                    stamps.append(datetime.fromisoformat(ts.replace("Z", "+00:00")))
                except Exception:
                    pass
        if not stamps:
            return "尚未检查"
        latest = max(stamps)
        delta = int((datetime.now(timezone.utc) - latest).total_seconds())
        if delta < 60:
            return "刚刚"
        if delta < 3600:
            return f"{delta // 60} 分钟前"
        if delta < 86400:
            return f"{delta // 3600} 小时前"
        return f"{delta // 86400} 天前"

    def _render_update_state(self, rows):
        d = rows.get("desktop") or {}
        g = rows.get("graphics") or {}
        b = rows.get("browser") or {}
        a = rows.get("apt") or {}

        self.upd_time_lbl.set_text(f"上次检查：{self._fmt_checked_at(rows)}")

        # Interrupted recovery banner
        interrupted = any(r.get("state") == "interrupted" for r in (d, g, b))
        self.upd_warn_box.set_visible(interrupted)

        # Path 1: Omarchy Desktop
        d_ver = d.get("installed_version")
        d_avail = d.get("available_version")
        d_state = d.get("state") or "unknown"
        rt_avail = any(r.get("state") == "available" for r in (g, b))
        desktop_has_upd = (d_state == "available") or rt_avail

        ver_txt = f"  v{d_ver}" if d_ver else ""
        self.upd_desk_title.set_text(f"Omarchy 桌面环境{ver_txt}")
        if d_state == "interrupted":
            self.upd_desk_status.set_text("更新中断 · 需恢复")
            self._set_badge_class(self.upd_desk_status, "warn-text")
        elif d_state == "available":
            self.upd_desk_status.set_text(f"可更新至 v{d_avail}" if d_avail else "有可用更新")
            self._set_badge_class(self.upd_desk_status, "warn-text")
        elif rt_avail:
            self.upd_desk_status.set_text("配套组件可更新")
            self._set_badge_class(self.upd_desk_status, "warn-text")
        elif d_state in ("current", "ahead"):
            self.upd_desk_status.set_text("已最新")
            self._set_badge_class(self.upd_desk_status, "ok-text")
        elif d_state == "incompatible":
            self.upd_desk_status.set_text("需升级客户端")
            self._set_badge_class(self.upd_desk_status, "warn-text")
        elif d_state == "failed":
            self.upd_desk_status.set_text("检查失败")
            self._set_badge_class(self.upd_desk_status, "warn-text")
        else:
            self.upd_desk_status.set_text("未检查")
            self._set_badge_class(self.upd_desk_status, "panel-dim")
        self.upd_desk_btn.set_visible(desktop_has_upd and not interrupted)

        # Path 2: Linux APT Packages
        a_state = a.get("state") or "unknown"
        apt_lines = [l for l in (a.get("detail") or "").splitlines() if l.strip()]
        apt_has_upd = a_state == "available"
        if apt_has_upd:
            self.upd_apt_status.set_text(f"{len(apt_lines)} 项可更新")
            self._set_badge_class(self.upd_apt_status, "warn-text")
        elif a_state == "current":
            self.upd_apt_status.set_text("已最新")
            self._set_badge_class(self.upd_apt_status, "ok-text")
        elif a_state == "failed":
            self.upd_apt_status.set_text("检查失败")
            self._set_badge_class(self.upd_apt_status, "warn-text")
        else:
            self.upd_apt_status.set_text("未检查")
            self._set_badge_class(self.upd_apt_status, "panel-dim")
        self.upd_apt_btn.set_visible(apt_has_upd)

        # Primary 1-click button
        total_paths = int(desktop_has_upd and not interrupted) + int(apt_has_upd)
        self.upd_all_btn.set_visible(total_paths > 0)
        if total_paths > 0:
            self.upd_all_btn.set_label(
                f"󰚰  一键更新全部 ({total_paths} 项)" if total_paths > 1 else "󰚰  一键更新可用项"
            )

    def _set_badge_class(self, widget, cls):
        ctx = widget.get_style_context()
        for c in ("ok-text", "warn-text", "panel-dim"):
            ctx.remove_class(c)
        ctx.add_class(cls)

    def _trigger_update_check(self, _btn=None):
        if getattr(self, "_upd_checking", False):
            return
        self._upd_checking = True
        self.upd_check_btn.set_sensitive(False)
        self.upd_check_btn.set_label("检查中...")
        self.upd_time_lbl.set_text("正在检查桌面与系统更新...")

        def worker():
            subprocess.run(
                ["/usr/local/bin/omarchy-updates", "check"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            rows = self._load_update_rows()
            GLib.idle_add(self._on_update_check_done, rows)

        threading.Thread(target=worker, daemon=True).start()

    def _on_update_check_done(self, rows):
        self._upd_checking = False
        self.upd_check_btn.set_sensitive(True)
        self.upd_check_btn.set_label("󰑐  检查更新")
        self._render_update_state(rows)
        return False

    def build_update(self):
        self.set_size_request(410, -1)

        # Header row
        hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        title = Gtk.Label(label="󰚰  更新中心", xalign=0)
