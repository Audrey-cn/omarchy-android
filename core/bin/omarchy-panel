#!/usr/bin/env python3
"""
Omarchy Official-Style Anchored Bar Popup Panels (GTK3 Wayland)
Replaces plain wofi text menus when clicking top-bar widgets:
  - calendar  : Month calendar grid (anchored top-center under clock)
  - audio     : Volume slider + mute toggle (anchored top-right)
  - monitor   : Display scale & screen controls (anchored top-right)
  - network   : Network / Wi-Fi / USB Proxy status card (anchored top-right)
  - bluetooth : Bluetooth & M15 touchpad rotation controls (anchored top-right)
  - power     : Battery, CPU/RAM, and power actions card (anchored top-right)
  - agents    : AI Agents live status & 1-click launcher (anchored top-right)
"""
import os
import re
import sys
import glob
import subprocess
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gtk, Gdk, GLib, GtkLayerShell

PIDFILE = "/tmp/omarchy-panel.pid"


def load_theme():
    bg, fg, accent = "#1a1b26", "#c0caf5", "#7aa2f7"
    p = "/root/.config/omarchy/current/theme/colors.toml"
    if os.path.exists(p):
        try:
            txt = open(p, encoding="utf-8", errors="ignore").read()
            m1 = re.search(r'^\s*background\s*=\s*"(#[0-9a-fA-F]{6})"', txt, re.M)
            m2 = re.search(r'^\s*foreground\s*=\s*"(#[0-9a-fA-F]{6})"', txt, re.M)
            m3 = re.search(r'^\s*accent\s*=\s*"(#[0-9a-fA-F]{6})"', txt, re.M)
            if m1: bg = m1.group(1)
            if m2: fg = m2.group(1)
            if m3: accent = m3.group(1)
        except Exception:
            pass
    return bg, fg, accent


def sh(cmd):
    try:
        return subprocess.check_output(cmd, shell=True, stderr=subprocess.DEVNULL, text=True).strip()
    except Exception:
        return ""


def get_swaysock():
    socks = sorted(glob.glob("/tmp/sway-ipc.*.sock"), key=os.path.getmtime, reverse=True)
    return socks[0] if socks else "/tmp/sway-ipc.sock"


def launch_bg(cmd):
    env = {
        **os.environ,
        "XDG_RUNTIME_DIR": "/tmp",
        "WAYLAND_DISPLAY": "wayland-1",
        "SWAYSOCK": get_swaysock(),
        "DBUS_SESSION_BUS_ADDRESS": "unix:path=/tmp/omarchy-dbus.sock",
    }
    subprocess.Popen(cmd, shell=True, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)


class OmarchyPanel(Gtk.Window):
    def __init__(self, mode):
        super().__init__(title=f"Omarchy {mode}")
        self.mode = mode
        self.set_decorated(False)
        self.set_resizable(False)

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 0)
        if mode != "calendar":
            GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, True)
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.RIGHT, 8)

        settings = Gtk.Settings.get_default()
        if settings:
            settings.set_property("gtk-application-prefer-dark-theme", True)

        bg, fg, accent = load_theme()
        css = f"""
        window {{
            background-color: {bg};
            border: 2px solid {accent};
            border-radius: 10px;
        }}
        .panel-box {{
            padding: 16px 18px;
            background-color: {bg};
        }}
        .panel-title {{
            color: {accent};
            font-family: "JetBrainsMono Nerd Font", "Noto Sans CJK SC", sans-serif;
            font-size: 14px;
            font-weight: bold;
            margin-bottom: 10px;
        }}
        .panel-row {{
            color: {fg};
            font-family: "JetBrainsMono Nerd Font", "Noto Sans CJK SC", sans-serif;
            font-size: 12px;
            margin: 3px 0;
        }}
        .panel-dim {{
            color: alpha({fg}, 0.65);
            font-family: "JetBrainsMono Nerd Font", "Noto Sans CJK SC", sans-serif;
            font-size: 11px;
        }}
        button.om-btn {{
            background-image: none;
            box-shadow: none;
            background-color: alpha({fg}, 0.09);
            color: {fg};
            border: 1px solid alpha({accent}, 0.45);
            border-radius: 7px;
            padding: 7px 12px;
            font-family: "JetBrainsMono Nerd Font", "Noto Sans CJK SC", sans-serif;
            font-size: 12px;
        }}
        button.om-btn:hover {{
            background-image: none;
            background-color: alpha({accent}, 0.28);
            border-color: {accent};
        }}
        calendar {{
            background-color: {bg};
            color: {fg};
            font-family: "JetBrainsMono Nerd Font", "Noto Sans CJK SC", sans-serif;
            font-size: 12px;
            border: none;
        }}
        calendar:selected {{
            background-color: {accent};
            color: {bg};
            border-radius: 4px;
        }}
        scale trough {{
            background-color: alpha({fg}, 0.16);
            border-radius: 4px;
            min-height: 6px;
        }}
        scale highlight {{
            background-color: {accent};
            border-radius: 4px;
        }}
        """
        prov = Gtk.CssProvider()
        prov.load_from_data(css.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.box.get_style_context().add_class("panel-box")
        self.add(self.box)

        if mode == "calendar":
            self.build_calendar()
        elif mode == "audio":
            self.build_audio()
        elif mode == "monitor":
            self.build_monitor()
        elif mode == "network":
            self.build_network()
        elif mode == "bluetooth":
            self.build_bluetooth()
        elif mode == "power":
            self.build_power()
        elif mode == "agents":
            self.build_agents()
        else:
            self.add_title("Omarchy 面板")

        self.connect("key-press-event", self.on_key)
        self.connect("destroy", Gtk.main_quit)
        self.show_all()

    def add_title(self, text):
        l = Gtk.Label(label=text, xalign=0)
        l.get_style_context().add_class("panel-title")
        self.box.pack_start(l, False, False, 0)

    def add_row(self, text, dim=False):
        l = Gtk.Label(label=text, xalign=0)
        l.get_style_context().add_class("panel-dim" if dim else "panel-row")
        l.set_line_wrap(True)
        self.box.pack_start(l, False, False, 0)
        return l

    def add_btn(self, label, cb):
        b = Gtk.Button(label=label)
        b.get_style_context().add_class("om-btn")
        b.connect("clicked", cb)
        self.box.pack_start(b, False, False, 0)
        return b

    def build_calendar(self):
        self.set_default_size(320, 270)
        self.add_title("󰃭  日历 (Calendar)")
        cal = Gtk.Calendar()
        cal.set_display_options(
            Gtk.CalendarDisplayOptions.SHOW_HEADING
            | Gtk.CalendarDisplayOptions.SHOW_DAY_NAMES
            | Gtk.CalendarDisplayOptions.SHOW_WEEK_NUMBERS
        )
        self.box.pack_start(cal, True, True, 0)

    def build_audio(self):
        self.set_default_size(300, 180)
        self.add_title("󰕾  音频控制 (Audio)")
        cur_vol = 60
        out = sh("PULSE_SERVER=127.0.0.1 pactl get-sink-volume @DEFAULT_SINK@")
        m = re.search(r"(\d+)%", out)
        if m:
            cur_vol = min(150, int(m.group(1)))
        lbl = self.add_row(f"主音量: {cur_vol}%")
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 120, 5)
        scale.set_value(cur_vol)
        scale.set_draw_value(False)

        def on_vol(s):
            v = int(s.get_value())
            lbl.set_text(f"主音量: {v}%")
            launch_bg(f"PULSE_SERVER=127.0.0.1 pactl set-sink-volume @DEFAULT_SINK@ {v}%; pkill -RTMIN+8 waybar")

        scale.connect("value-changed", on_vol)
        self.box.pack_start(scale, False, False, 4)

        def on_mute(_):
            launch_bg("PULSE_SERVER=127.0.0.1 pactl set-sink-mute @DEFAULT_SINK@ toggle; pkill -RTMIN+8 waybar")
            Gtk.main_quit()

        self.add_btn("󰝟  静音 / 取消静音", on_mute)

    def build_monitor(self):
        self.set_default_size(300, 220)
        self.add_title("󰃠  显示与缩放 (Monitor)")
        self.add_row("当前分辨率: 2336 × 1080 (Wayland)", dim=True)
        for label, sc in [("1.0x 精细视野 (更多内容)", "1.0"), ("1.25x 默认推荐", "1.25"), ("1.5x 舒适大字", "1.5")]:
            self.add_btn(f"󰍹  缩放 {label}", lambda _, s=sc: (launch_bg(f"swaymsg 'output X11-1 scale {s}'"), Gtk.main_quit()))

    def build_network(self):
        self.set_default_size(310, 210)
        self.add_title("󰖩  网络状态 (Network)")
        wlan = sh("ip -4 addr show wlan0 | awk '/inet / {print $2}'")
        proxy_ok = sh("bash -c '</dev/tcp/127.0.0.1/18888' && echo OK") == "OK"
        self.add_row(f"Wi-Fi (wlan0): {wlan if wlan else '未连接'}")
        self.add_row(f"USB 代理隧道: {'已连接 (127.0.0.1:18888)' if proxy_ok else '未连接'}", dim=not proxy_ok)
        self.add_btn("󰑓  刷新网络状态", lambda _: (launch_bg("pkill -RTMIN+7 waybar"), Gtk.main_quit()))

    def build_bluetooth(self):
        self.set_default_size(310, 220)
        self.add_title("󰂯  蓝牙与 M15 键盘 (Bluetooth)")
        m15 = sh("grep -q 'M15' /proc/bus/input/devices && echo '已连接 (evdev 已接管)' || echo '未检测到'")
        rot = sh("cat /root/.config/omarchy/touchpad-rotation 2>/dev/null || echo 0")
        self.add_row(f"M15 键盘/触控板: {m15}")
        self.add_row(f"触控板旋转角度: {rot}°", dim=True)
        self.add_btn("󰑐  切换触控板方向 (0/90/180/270°)", lambda _: (launch_bg("python3 -c \"p='/root/.config/omarchy/touchpad-rotation'; c=int(open(p).read().strip()) if __import__('os').path.exists(p) else 0; n={0:90,90:270,270:180,180:0}.get(c,0); open(p,'w').write(str(n))\""), Gtk.main_quit()))

    def build_power(self):
        self.set_default_size(310, 260)
        self.add_title("󰁹  电源与系统状态 (Power)")
        cap = sh("cat /sys/class/power_supply/battery/capacity 2>/dev/null || echo 100")
        stat = sh("cat /sys/class/power_supply/battery/status 2>/dev/null || echo Charging")
        mem = sh("free -h | awk '/^Mem:/ {print $3 \" / \" $2}'")
        self.add_row(f"电池电量: {cap}% ({stat})")
        self.add_row(f"内存占用: {mem}", dim=True)
        self.add_btn("󰍛  打开 btop 系统监视器", lambda _: (launch_bg("alacritty -e btop --utf-force"), Gtk.main_quit()))
        self.add_btn("󰐥  打开 Omarchy 系统菜单", lambda _: (launch_bg("/usr/local/bin/omarchy-menu-ui system"), Gtk.main_quit()))

    def build_agents(self):
        self.set_default_size(320, 270)
        self.add_title("󰚩  AI 智能体中心 (Agents)")
        cc_up = "运行中 (127.0.0.1:15721)" if sh("pgrep -x cc-switch") else "未启动"
        self.add_row(f"CC Switch 网关: {cc_up}")
        self.add_row("当前路由: Xiaomi MiMo Token Plan (mimo-v2.6-pro)", dim=True)
        self.add_btn("󰣆  打开 CC Switch", lambda _: (launch_bg("/usr/local/bin/cc-switch-launch"), Gtk.main_quit()))
        self.add_btn("󰚩  打开 Codex Desktop", lambda _: (launch_bg("/usr/local/bin/chatgpt-launch"), Gtk.main_quit()))
        self.add_btn("󰚩  打开 Claude Desktop", lambda _: (launch_bg("/usr/local/bin/claude-desktop-launch"), Gtk.main_quit()))
        self.add_btn("󰚩  打开 Hermes Desktop", lambda _: (launch_bg("/usr/local/bin/hermes-desktop-launch"), Gtk.main_quit()))

    def on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            Gtk.main_quit()
            return True
        return False


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else "power"
    # Toggle if same panel is already open
    if os.path.exists(PIDFILE):
        try:
            old_pid, old_mode = open(PIDFILE).read().strip().split(":", 1)
            os.kill(int(old_pid), 15)
            os.remove(PIDFILE)
            if old_mode == mode:
                raise SystemExit(0)
        except SystemExit:
            raise
        except Exception:
            pass
    try:
        open(PIDFILE, "w").write(f"{os.getpid()}:{mode}")
    except Exception:
        pass

    app_id = "omarchy-panel-center" if mode == "calendar" else "omarchy-panel-right"
    GLib.set_prgname(app_id)
    win = OmarchyPanel(mode)
    try:
        Gtk.main()
    finally:
        try:
            if os.path.exists(PIDFILE) and open(PIDFILE).read().startswith(f"{os.getpid()}:"):
                os.remove(PIDFILE)
        except Exception:
            pass
