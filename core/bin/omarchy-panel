                "一键更新全部", "/usr/local/bin/omarchy-updates apply all"
            ),
        )
        self.box.pack_start(self.upd_all_btn, False, False, 0)

        # Collapsed Advanced Maintenance section
        exp = Gtk.Expander(label="高级维护与故障修复")
        exp.set_expanded(False)
        adv_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        adv_box.set_margin_top(6)
        for lbl, t_title, cmd in [
            (
                "󰜉  恢复上次桌面更新",
                "恢复上次桌面更新",
                "/usr/local/bin/omarchy-component-update recover && /usr/local/bin/omarchy-updates check",
            ),
            (
                "󰃢  清理冗余软件包 (APT autoremove)",
                "清理冗余软件包",
                "apt-get autoremove -y",
            ),
            (
                "󰋼  查看本机桌面组件清单",
                "本机桌面组件清单",
                "/usr/local/bin/omarchy-component-update inventory",
            ),
        ]:
            b = Gtk.Button(label=lbl)
            b.set_alignment(0, 0.5)
            b.get_style_context().add_class("panel-btn")
            b.connect("clicked", lambda _w, tt=t_title, cc=cmd: self._run_update_terminal(tt, cc))
            adv_box.pack_start(b, False, False, 0)
        exp.add(adv_box)
        self.box.pack_start(exp, False, False, 0)

        # Populate from cache and auto-check if missing or stale
        for child in self.upd_warn_box.get_children():
            child.show_all()
        for w in (self.upd_warn_box, self.upd_desk_btn, self.upd_apt_btn, self.upd_all_btn):
            w.set_no_show_all(True)
        rows = self._load_update_rows()
        self._render_update_state(rows)
        needs_auto = (
            not rows
            or any(
                (rows.get(k) or {}).get("state") in (None, "stale", "unknown")
                for k in ("desktop", "apt")
            )
        )
        if needs_auto:
            GLib.idle_add(self._trigger_update_check)

    def on_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            Gtk.main_quit()
            return True
        if self.mode == "keyboard" and hasattr(self, "probe_lbl"):
            kname = Gdk.keyval_name(ev.keyval) or str(ev.keyval)
            self.probe_lbl.set_text(f"Wayland 事件: {kname} (keyval={ev.keyval})\n提示: 该按键已正常送达桌面环境")
        return False


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else "power"
    # Toggle if same panel is already open
    if os.path.exists(PIDFILE):
        try:
            old_pid, old_mode = open(PIDFILE).read().strip().split(":", 1)
            os.kill(int(old_pid), 15)
            os.remove(PIDFILE)
            if old_mode == mode:
                raise SystemExit(0)
        except SystemExit:
            raise
        except Exception:
            pass
    try:
        open(PIDFILE, "w").write(f"{os.getpid()}:{mode}")
    except Exception:
        pass

    app_id = "omarchy-panel-center" if mode in ("calendar", "update") else "omarchy-panel-right"
    GLib.set_prgname(app_id)
    win = OmarchyPanel(mode)
    try:
        Gtk.main()
    finally:
        try:
            if mode == "keyboard" and os.path.exists(KEYPROBE_FLAG):
                os.remove(KEYPROBE_FLAG)
        except Exception:
            pass
        try:
            if os.path.exists(PIDFILE) and open(PIDFILE).read().startswith(f"{os.getpid()}:"):
                os.remove(PIDFILE)
        except Exception:
            pass
