        c2_title.get_style_context().add_class("update-card-title")
        c2_top.pack_start(c2_title, True, True, 0)
        self.upd_apt_status = Gtk.Label(label="未检查", xalign=1)
        c2_top.pack_end(self.upd_apt_status, False, False, 0)
        c2.pack_start(c2_top, False, False, 0)
        c2_bot = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        c2_sub = Gtk.Label(label="Ubuntu 基础库与已配置软件源 (APT)", xalign=0)
        c2_sub.get_style_context().add_class("panel-dim")
