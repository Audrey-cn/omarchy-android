        }}
        .update-card-title {{
            color: {fg};
            font-family: "JetBrainsMono Nerd Font", "Noto Sans CJK SC", sans-serif;
            font-size: 13px;
            font-weight: bold;
        }}
        .update-primary {{
            background-color: alpha({accent}, 0.24);
            color: {fg};
            border: 1px solid {accent};
            border-radius: 6px;
            padding: 8px 12px;
            font-family: "JetBrainsMono Nerd Font", "Noto Sans CJK SC", sans-serif;
            font-size: 12px;
            font-weight: bold;
        }}
        .update-primary:hover {{
            background-color: alpha({accent}, 0.38);
        }}
        expander title {{
            color: alpha({fg}, 0.68);
            font-family: "JetBrainsMono Nerd Font", "Noto Sans CJK SC", sans-serif;
            font-size: 11px;
