#!/usr/bin/env python3
"""
Omarchy Official-Style Visual Theme & Wallpaper Picker (GTK3 + GtkLayerShell)
Replaces plain wofi text lists for `appearance.theme` and `appearance.background`:
  - `omarchy-image-picker theme`      : Visual 3-column grid of all 23 official themes
                                        (16:9 wallpaper thumbnail + color swatches + name)
  - `omarchy-image-picker background` : Visual 3-column grid of all wallpapers in active theme
"""
import os
import re
import sys
import glob
import hashlib
import subprocess
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gtk, Gdk, GdkPixbuf, GLib, GtkLayerShell

OMARCHY_PATH = "/root/.local/share/omarchy"
STATE_DIR = "/root/.local/state/omarchy/current"
THUMB_CACHE = "/root/.cache/omarchy-thumbs"
PIDFILE = "/tmp/omarchy-image-picker.pid"
os.makedirs(THUMB_CACHE, exist_ok=True)


def parse_colors(toml_path):
    bg, fg, accent = "#1a1b26", "#c0caf5", "#7aa2f7"
    swatches = []
    if os.path.exists(toml_path):
        txt = open(toml_path, encoding="utf-8", errors="ignore").read()
        for k in ("background", "foreground", "accent", "color1", "color2", "color4", "color5"):
            m = re.search(rf'^\s*{k}\s*=\s*"(#[0-9a-fA-F]{{6}})"', txt, re.M)
            if m:
                if k == "background": bg = m.group(1)
                elif k == "foreground": fg = m.group(1)
                elif k == "accent": accent = m.group(1)
                else: swatches.append(m.group(1))
    return bg, fg, accent, swatches


def get_thumb_pixbuf(img_path, w=240, h=135):
    if not img_path or not os.path.exists(img_path):
        return None
    hkey = hashlib.md5(f"{img_path}:{w}x{h}".encode()).hexdigest()
    cached = os.path.join(THUMB_CACHE, f"{hkey}.png")
    if not os.path.exists(cached):
        if img_path.lower().endswith(".webp"):
            subprocess.run(["dwebp", img_path, "-resize", str(w), str(h), "-o", cached],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        else:
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(img_path, w, h, False)
                pb.savev(cached, "png", [], [])
            except Exception:
                return None
    if os.path.exists(cached):
        try:
            return GdkPixbuf.Pixbuf.new_from_file_at_scale(cached, w, h, False)
        except Exception:
            return None
    return None


class OmarchyImagePicker(Gtk.Window):
    def __init__(self, mode):
        super().__init__(title="Omarchy Picker")
        self.mode = mode
        self.set_decorated(False)
        self.set_resizable(False)
        self.set_default_size(860, 540)

        settings = Gtk.Settings.get_default()
        if settings:
            settings.set_property("gtk-application-prefer-dark-theme", True)

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.EXCLUSIVE)

        cur_theme = open(f"{STATE_DIR}/theme.name").read().strip() if os.path.exists(f"{STATE_DIR}/theme.name") else "tokyo-night"
        bg, fg, accent, _ = parse_colors(f"{OMARCHY_PATH}/themes/{cur_theme}/colors.toml")

        css = f"""
        window {{
            background-color: {bg};
            border: 2px solid {accent};
            border-radius: 12px;
        }}
        .root-box {{
            padding: 18px 20px;
            background-color: {bg};
        }}
        .picker-title {{
            color: {accent};
            font-family: "JetBrainsMono Nerd Font", "Noto Sans CJK SC", sans-serif;
            font-size: 15px;
            font-weight: bold;
            margin-bottom: 12px;
        }}
        .search-entry {{
            background-color: alpha({fg}, 0.08);
            color: {fg};
            border: 1px solid alpha({accent}, 0.45);
            border-radius: 8px;
            padding: 8px 12px;
            font-family: "JetBrainsMono Nerd Font", "Noto Sans CJK SC", sans-serif;
            font-size: 13px;
            margin-bottom: 14px;
        }}
        flowboxchild {{
            border-radius: 10px;
            padding: 8px;
            border: 2px solid transparent;
            background-color: alpha({fg}, 0.04);
        }}
        flowboxchild:hover {{
            background-color: alpha({fg}, 0.10);
        }}
        flowboxchild:selected {{
            background-color: alpha({accent}, 0.22);
            border: 2px solid {accent};
        }}
        .item-label {{
            color: {fg};
            font-family: "JetBrainsMono Nerd Font", "Noto Sans CJK SC", sans-serif;
            font-size: 12px;
            font-weight: 600;
            margin-top: 6px;
        }}
        """
        prov = Gtk.CssProvider()
        prov.load_from_data(css.encode("utf-8"))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        vbox.get_style_context().add_class("root-box")
        self.add(vbox)

        title = "  选择 Omarchy 主题 (Theme Switcher)" if mode == "theme" else f"  选择壁纸 ({cur_theme})"
        lbl = Gtk.Label(label=title, xalign=0)
        lbl.get_style_context().add_class("picker-title")
        vbox.pack_start(lbl, False, False, 0)

        self.search = Gtk.Entry()
        self.search.set_placeholder_text("输入关键词筛选 · 回车或点击应用 · Esc 退出")
        self.search.get_style_context().add_class("search-entry")
        self.search.connect("changed", self.on_filter)
        self.search.connect("activate", self.on_activate)
        vbox.pack_start(self.search, False, False, 0)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        vbox.pack_start(scrolled, True, True, 0)

        self.flow = Gtk.FlowBox()
        self.flow.set_valign(Gtk.Align.START)
        self.flow.set_min_children_per_line(3)
        self.flow.set_max_children_per_line(3)
        self.flow.set_homogeneous(True)
        self.flow.set_row_spacing(12)
        self.flow.set_column_spacing(12)
        self.flow.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.flow.set_activate_on_single_click(True)
        self.flow.connect("child-activated", self.on_child_activated)
        scrolled.add(self.flow)

        self.cur_theme = cur_theme
        self.populate()

        self.flow.set_filter_func(self.filter_func)
        self.connect("key-press-event", self.on_key)
        self.connect("destroy", Gtk.main_quit)
        self.show_all()
        self.select_first()
        self.search.grab_focus()

    def populate(self):
        if self.mode == "theme":
            themes = sorted([t for t in os.listdir(f"{OMARCHY_PATH}/themes")
                             if os.path.isdir(f"{OMARCHY_PATH}/themes/{t}")])
            for t in themes:
                bgs = sorted(glob.glob(f"{OMARCHY_PATH}/themes/{t}/backgrounds/*"))
                img = bgs[0] if bgs else None
                tbg, tfg, tac, sw = parse_colors(f"{OMARCHY_PATH}/themes/{t}/colors.toml")
                dots = " ".join([f"<span foreground='{c}'>●</span>" for c in ([tac] + sw)[:4]])
                mark = "  ✓" if t == self.cur_theme else ""
                self.add_card(f"{t}{mark}", img, ("theme", t), t.lower(), dots_markup=dots)
        else:
            bgs = sorted(glob.glob(f"{OMARCHY_PATH}/themes/{self.cur_theme}/backgrounds/*"))
            for b in bgs:
                name = os.path.basename(b)
                self.add_card(name, b, ("bg", b), name.lower())

    def add_card(self, label, img_path, payload, search_key, dots_markup=None):
        child = Gtk.FlowBoxChild()
        child.payload = payload
        child.search_key = search_key
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        box.set_halign(Gtk.Align.CENTER)

        pb = get_thumb_pixbuf(img_path, 240, 135)
        if pb:
            im = Gtk.Image.new_from_pixbuf(pb)
        else:
            im = Gtk.Image.new_from_icon_name("image-x-generic", Gtk.IconSize.DIALOG)
        box.pack_start(im, False, False, 0)

        lbl = Gtk.Label(label=label)
        lbl.get_style_context().add_class("item-label")
        lbl.set_max_width_chars(24)
        box.pack_start(lbl, False, False, 0)

        if dots_markup:
            dlbl = Gtk.Label()
            dlbl.set_markup(dots_markup)
            box.pack_start(dlbl, False, False, 0)

        child.add(box)
        self.flow.add(child)

    def filter_func(self, child):
        q = self.search.get_text().strip().lower()
        return (not q) or (q in child.search_key)

    def visible_children(self):
        return [c for c in self.flow.get_children() if self.filter_func(c)]

    def select_first(self):
        vis = self.visible_children()
        if vis:
            self.flow.select_child(vis[0])

    def on_filter(self, _):
        self.flow.invalidate_filter()
        self.select_first()

    def apply_payload(self, payload):
        kind, val = payload
        if kind == "theme":
            cmd = ["/usr/local/bin/omarchy-theme-engine.py", "set", val]
        else:
            cmd = ["/usr/local/bin/omarchy-theme-engine.py", "set", self.cur_theme, val]
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        Gtk.main_quit()

    def on_child_activated(self, _flow, child):
        self.apply_payload(child.payload)

    def on_activate(self, _):
        sel = self.flow.get_selected_children()
        if sel:
            self.apply_payload(sel[0].payload)

    def move_sel(self, delta):
        vis = self.visible_children()
        if not vis:
            return
        sel = self.flow.get_selected_children()
        idx = vis.index(sel[0]) if (sel and sel[0] in vis) else 0
        self.flow.select_child(vis[max(0, min(len(vis) - 1, idx + delta))])

    def on_key(self, _w, ev):
        k = ev.keyval
        if k == Gdk.KEY_Escape:
            Gtk.main_quit(); return True
        if k in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self.on_activate(None); return True
        if k == Gdk.KEY_Right: self.move_sel(1); return True
        if k == Gdk.KEY_Left: self.move_sel(-1); return True
        if k == Gdk.KEY_Down: self.move_sel(3); return True
        if k == Gdk.KEY_Up: self.move_sel(-3); return True
        return False


if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else "theme"
    if os.path.exists(PIDFILE):
        try:
            old_pid = int(open(PIDFILE).read().strip())
            if old_pid != os.getpid():
                os.kill(old_pid, 15)
                os.remove(PIDFILE)
                raise SystemExit(0)
        except SystemExit:
            raise
        except Exception:
            pass
    try:
        open(PIDFILE, "w").write(str(os.getpid()))
    except Exception:
        pass
    GLib.set_prgname("omarchy-image-picker")
    OmarchyImagePicker(mode)
    try:
        Gtk.main()
    finally:
        try:
            if os.path.exists(PIDFILE) and open(PIDFILE).read().strip() == str(os.getpid()):
                os.remove(PIDFILE)
        except Exception:
            pass
