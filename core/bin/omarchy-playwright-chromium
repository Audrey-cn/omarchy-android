#!/usr/bin/env bash
# Real pinned GUI Chromium; CDP is opt-in and has a separate Agent profile.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
AGENT=0
if [[ "${1:-}" == --agent ]]; then AGENT=1; shift; fi
ASCII_SPACE=$' \t\n\v\f\r'
for ARG in "$@"; do
  # Chromium trims ASCII whitespace before recognizing a switch. Check that
  # normalized copy, but forward the original argv unchanged for URLs.
  CHECK="${ARG#"${ARG%%[!$ASCII_SPACE]*}"}"
  CHECK="${CHECK%"${CHECK##*[!$ASCII_SPACE]}"}"
  case "$CHECK" in
    -*)
      # Chromium's POSIX parser accepts both '-' and '--' switch prefixes.
      SWITCH="${CHECK#-}"
      SWITCH="${SWITCH#-}"
      case "$SWITCH" in
        agent|agent=*|remote-debugging*|remote-allow-origins*|user-data-dir*|profile-directory*|headless*|ozone-platform*|gtk-version|gtk-version=*)
          echo "omarchy-playwright-chromium: profile/display/CDP options are managed; use --agent for loopback CDP." >&2
          exit 2 ;;
      esac
      ;;
  esac
done
BROWSER="$("$SCRIPT_DIR/omarchy-playwright128" browser-path chromium)"
KEYBOARD_RESTORE="$SCRIPT_DIR/omarchy-restore-x11-keyboard"
if [[ -e "$KEYBOARD_RESTORE" || -L "$KEYBOARD_RESTORE" ]]; then
  "$KEYBOARD_RESTORE" || {
    STATUS=$?
    echo "Chromium 启动已停止：无法恢复 X11 键盘状态。" >&2
    exit "$STATUS"
  }
fi
PROFILE="${HOME:-/root}/.local/share/omarchy-chromium128/desktop"
if [[ "$AGENT" == 1 ]]; then
  PROFILE="${HOME:-/root}/.local/share/omarchy-chromium128/agent"
fi
mkdir -p "$PROFILE"
# Chromium 128 uses GTK4's input context with Fcitx on Sway.
export GDK_BACKEND=wayland
export GTK_IM_MODULE="${GTK_IM_MODULE:-fcitx}"
if [[ "$AGENT" == 1 ]]; then
  set -- --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 "$@"
fi
exec "$BROWSER" --no-sandbox --ozone-platform=wayland --gtk-version=4 --user-data-dir="$PROFILE" "$@"
