#!/usr/bin/env python3
"""Ensure Hermes Agent's Python venv has PRoot-safe runtime & gateway packages."""

from __future__ import annotations

import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

# (import_name, pip_package_name)
REQUIRED_MODULES = (
    ("ruamel.yaml", "ruamel.yaml"),
    ("psutil", "psutil"),
    ("fastapi", "fastapi"),
    ("uvicorn", "uvicorn"),
    ("websockets", "websockets"),
    ("multipart", "python-multipart"),
    ("sse_starlette", "sse-starlette"),
    ("snowballstemmer", "snowballstemmer"),
)

DEFAULT_VENVS = (
    Path.home() / ".hermes" / "hermes-agent" / "venv",
    Path("/usr/local/lib/hermes-agent/venv"),
)
DEFAULT_UV_CANDIDATES = (
    Path("/root/.hermes/bin/uv"),
    Path("/usr/local/bin/uv"),
)


def find_missing_packages(python_bin: Path) -> list[str]:
    probe = (
        "import importlib, json, sys\n"
        "pairs = json.loads(sys.argv[1])\n"
        "missing = []\n"
        "for mod, pkg in pairs:\n"
        "    try:\n"
        "        importlib.import_module(mod)\n"
        "    except Exception:\n"
        "        missing.append(pkg)\n"
        "print(json.dumps(missing))\n"
    )
    result = subprocess.run(
        [str(python_bin), "-c", probe, json.dumps(REQUIRED_MODULES)],
        capture_output=True,
        text=True,
        timeout=30,
        check=False,
    )
    if result.returncode != 0:
        return [pkg for _, pkg in REQUIRED_MODULES]
    try:
        parsed = json.loads(result.stdout.strip() or "[]")
        return [str(pkg) for pkg in parsed if isinstance(pkg, str)]
    except json.JSONDecodeError:
        return [pkg for _, pkg in REQUIRED_MODULES]


def find_uv() -> str | None:
    override = os.environ.get("HERMES_UV_BIN")
    if override and Path(override).is_file():
        return override
    for candidate in DEFAULT_UV_CANDIDATES:
        if candidate.is_file() and os.access(candidate, os.X_OK):
            return str(candidate)
    return shutil.which("uv")


def repair_venv(venv_dir: Path) -> int:
    python_bin = venv_dir / "bin" / "python"
    if not (python_bin.is_file() and os.access(python_bin, os.X_OK)):
        return 0

    missing = find_missing_packages(python_bin)
    if not missing:
        return 0

    env = dict(os.environ)
    env["UV_LINK_MODE"] = "copy"

    uv_bin = find_uv()
    if uv_bin:
        cmd = [uv_bin, "pip", "install", "--python", str(python_bin), *missing]
    else:
        cmd = [str(python_bin), "-m", "pip", "install", "--quiet", *missing]

    print(
        f"[omarchy-ensure-hermes-venv] Repairing missing Hermes venv packages: {', '.join(missing)}",
        file=sys.stderr,
    )
    result = subprocess.run(cmd, env=env, check=False)
    if result.returncode != 0:
        print(
            "[omarchy-ensure-hermes-venv] Warning: package repair exited with status "
            f"{result.returncode}; continuing launch.",
            file=sys.stderr,
        )
    return 0


def main() -> int:
    override = os.environ.get("HERMES_VENV_DIR")
    if override:
        return repair_venv(Path(override))
    for venv_dir in DEFAULT_VENVS:
        repair_venv(venv_dir)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
