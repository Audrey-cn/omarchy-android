#!/usr/bin/env bash
# Legacy browser/WebApp compatibility launcher (PRoot uses WebKitGTK).
# Real Playwright Chromium is launched by omarchy-playwright-chromium.
set -euo pipefail

# In Root Chroot mode, forward to Termux host Chromium daemon if available
if [[ -f /data/adb/ubuntu-chroot.sh ]]; then
  python3 - "$@" <<'PY'
import os, sys, time, json
QUEUE_DIR = "/tmp/omarchy-browser-queue"
os.makedirs(QUEUE_DIR, exist_ok=True)
with open(f"{QUEUE_DIR}/job-{int(time.time()*1000000)}.json", "w") as f:
    json.dump({"args": sys.argv[1:]}, f)
PY
  exit 0
fi

# In Non-Root All-in-One APK (PRoot), launch native in-system WebKitGTK 4.1 browser!
exec /usr/local/bin/omarchy-browser "$@"
