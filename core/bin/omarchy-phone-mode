#!/usr/bin/env bash
# Omarchy Phone Mode (Portrait + Virtual Keyboard) <-> Desktop Mode (Landscape)
set -u

STATE_DIR="/root/.local/state/omarchy"
STATE_FILE="$STATE_DIR/phone-mode"
SCALE_FILE="/root/.config/omarchy/display-scale"
QUEUE_DIR="/tmp/omarchy-browser-queue"
mkdir -p "$STATE_DIR" "$QUEUE_DIR"

get_swaysock() {
  ls -t /tmp/sway-ipc.*.sock 2>/dev/null | head -n 1
}

send_host() {
  printf '{"action":"%s"}\n' "$1" > "$QUEUE_DIR/pm_$$_$1.json"
}

cur="landscape"
[[ -f "$STATE_FILE" ]] && cur=$(cat "$STATE_FILE" 2>/dev/null || echo landscape)

case "${1:-status}" in
  status)
    if [[ "$cur" == "portrait" ]]; then
      echo '{"text":"󰏲","class":"active"}'
    else
      echo '{"text":"󰍹","class":"inactive"}'
    fi
    ;;
  toggle)
    export XDG_RUNTIME_DIR=/tmp
    export WAYLAND_DISPLAY=wayland-1
    export SWAYSOCK="$(get_swaysock)"
    export GDK_BACKEND=wayland
    if [[ "$cur" == "portrait" ]]; then
      echo "landscape" > "$STATE_FILE"
      /usr/local/bin/omarchy-osk close-all >/dev/null 2>&1 || true
      send_host "rotate_landscape"
      sleep 0.7
      saved="1.25"
      [[ -f "$SCALE_FILE" ]] && saved=$(cat "$SCALE_FILE" 2>/dev/null || echo "1.25")
      swaymsg "output X11-1 scale $saved" >/dev/null 2>&1 || true
    else
      echo "portrait" > "$STATE_FILE"
      send_host "rotate_portrait"
      sleep 0.7
      swaymsg "output X11-1 scale 1.35" >/dev/null 2>&1 || true
      setsid /usr/local/bin/omarchy-osk fab </dev/null >/tmp/osk-fab.log 2>&1 &
    fi
    pkill -RTMIN+12 waybar 2>/dev/null || true
    ;;
esac
