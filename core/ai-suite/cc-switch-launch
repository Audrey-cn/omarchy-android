#!/bin/bash
export WEBKIT_DISABLE_DMABUF_RENDERER=1
export WEBKIT_DISABLE_COMPOSITING_MODE=1
export GDK_BACKEND=wayland
export XDG_RUNTIME_DIR=/tmp
export WAYLAND_DISPLAY=wayland-1
python3 - << "PY"
import os, socket, sqlite3, sys
from contextlib import closing
from pathlib import Path
s = socket.socket()
s.settimeout(0.3)
try:
    s.connect(("127.0.0.1", 18888))
    up = True
except Exception:
    up = False
finally:
    s.close()
if any(entry.strip() == "*" for name in ("no_proxy", "NO_PROXY")
       for entry in os.environ.get(name, "").split(",")):
    up = False
db = Path("/root/.cc-switch/cc-switch.db")
if db.is_file():
    try:
        # Let CC Switch create and migrate its own database on first launch.
        with closing(sqlite3.connect(db.as_uri() + "?mode=rw", uri=True)) as c:
            if c.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name=?", ("settings",)).fetchone():
                if up:
                    c.execute("INSERT OR REPLACE INTO settings(key,value) VALUES(?,?)", ("global_proxy_url", "http://127.0.0.1:18888"))
                else:
                    c.execute("DELETE FROM settings WHERE key=?", ("global_proxy_url",))
                c.commit()
    except sqlite3.Error as error:
        print(f"CC Switch proxy setup skipped: {error}", file=sys.stderr)
PY
exec /usr/bin/cc-switch "$@"
